    "@fastify/jwt": "10.2.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@sr/db": "workspace:^",
    "@sr/shared": "workspace:*",
    "ai": "7.0.176",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
