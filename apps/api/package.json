{
  "name": "@sr/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --include '../../packages/*/dist/**' src/main.ts",
    "start": "node dist/main.js",
